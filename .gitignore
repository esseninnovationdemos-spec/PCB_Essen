# Unreal Engine generated
Binaries/
Build/
Intermediate/
Saved/
DerivedDataCache/
FileOpenOrder/
.vs/
*.VC.db
*.VC.opendb

# VS / Rider project files (regenerated by UBT)
*.sln
*.slnx
*.suo
*.opensdf
*.sdf
*.xcworkspace
*.xcodeproj
*.idea/
# Visual Studio upgrade leftovers
UpgradeLog.htm
/Backup/

# Per-user editor settings, not project config
Config/DefaultEditorPerProjectUserSettings.ini

# Python bytecode, wherever a tool happens to run from
__pycache__/
*.py[co]

# Backup files left by the project
Config/*.bak

# UE crash/log artifacts
*.dmp
*.log

# OS
.DS_Store
Thumbs.db

# FactoryTwin broker capture scratch (see Tools/broker/README.md)
Tools/broker/_capture/

# Imported model sources kept outside Content; the build commandlet imports them
# on demand and the resulting assets are what the project actually uses.
/warehouse6.fbx

# Showcase renders: 2560x1440 PNGs at ~4 MB each. The thumbnails and the
# gallery are committed; the full-resolution set is regenerated by
# Tools/butchery/render_showcase.ps1 and would put ~110 MB in history.
Tools/butchery/showcase/*.png

# Tour videos: 1440p60 H.264, the main one ~260 MB. Regenerated by
# Tools/butchery/render_both.ps1 in about twenty minutes.
Saved/Renders/*.mp4
