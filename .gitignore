# Backup files left by the project
Content/Python/*.bak
Config/*.bak

# UE crash/log artifacts
*.dmp
*.log

# OS
.DS_Store
Thumbs.db

# FactoryTwin broker capture scratch
Tools/broker/_capture/

# VS / Rider solution files regenerated by UBT (the *.sln rule predates .slnx)
*.slnx
# Per-user editor settings, not project config
Config/DefaultEditorPerProjectUserSettings.ini
# Visual Studio upgrade report
UpgradeLog.htm
